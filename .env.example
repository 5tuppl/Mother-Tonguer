# Optional. Enables OpenAI-backed translation, ASR, and generated audio.
# Without this, the app uses no-key translation fallbacks and browser speech where available.
OPENAI_API_KEY=

# Optional. Leave these empty to use the same Vercel deployment as the API.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_WS_URL=

# Optional OpenAI model/voice overrides.
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Optional OmniVoice business communications API integration.
OMNIVOICE_API_KEY=
OMNIVOICE_SECRET_KEY=
OMNIVOICE_API_BASE_URL=https://api.omnivoice.ai
OMNIVOICE_API_VERSION=v4

# Optional: forward local-first history records to your own sync endpoint.
HISTORY_SYNC_URL=
HISTORY_SYNC_TOKEN=
